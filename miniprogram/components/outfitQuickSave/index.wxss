@import "../../styles/theme-tokens.wxss";

.quick-save-mask { position: fixed; right: 0; bottom: 0; left: 0; top: 0; z-index: 290; background: rgba(95, 81, 87, 0.28); }
.quick-save-panel { position: fixed; right: 12rpx; bottom: 0; left: 12rpx; z-index: 300; padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); border: 3rpx solid var(--skin-border); border-bottom: 0; border-radius: 38rpx 38rpx 0 0; background: var(--skin-surface); box-shadow: var(--skin-shadow); color: var(--skin-ink); }
.quick-save-head { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.quick-save-title, .quick-save-sub { display: block; }
.quick-save-title { color: var(--skin-ink); font-size: 34rpx; font-weight: 900; }
.quick-save-sub { margin-top: 7rpx; color: var(--skin-muted); font-size: 22rpx; }
.quick-save-head > view:first-child { flex: 1; min-width: 0; }
.quick-save-close-hit { display: flex; min-width: var(--touch-target); min-height: var(--touch-target); align-items: center; justify-content: flex-end; }
.quick-save-close { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border: 3rpx solid var(--skin-border); border-radius: 50%; background: var(--skin-surface); color: var(--skin-ink); font-size: 30rpx; font-weight: 900; }
.quick-save-input, .quick-save-note { width: 100%; border: 3rpx solid var(--skin-border); border-radius: 22rpx; background: var(--skin-surface); color: var(--skin-ink); font-size: 26rpx; }
.quick-save-input { height: 82rpx; padding: 0 22rpx; }
.quick-save-note { min-height: 104rpx; margin-top: 16rpx; padding: 20rpx 22rpx; }
.quick-save-confirm { display: flex; min-height: var(--touch-target); margin-top: 22rpx; align-items: center; justify-content: center; border: 3rpx solid var(--skin-border); border-radius: 26rpx; background: linear-gradient(180deg, #ffe680, #ffd84d); box-shadow: var(--skin-shadow); color: var(--skin-ink); font-size: 28rpx; font-weight: 900; }
.quick-save-confirm.is-loading { opacity: 0.66; }
