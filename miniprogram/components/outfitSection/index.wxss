@import "../../styles/theme-tokens.wxss";

.outfit-section {
  margin: 34rpx 0 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx dashed var(--skin-border);
  color: var(--skin-ink);
}

.outfit-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.outfit-section-title,
.outfit-section-sub {
  display: block;
}

.outfit-section-title {
  color: var(--skin-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.outfit-section-sub {
  margin-top: 6rpx;
  color: var(--skin-muted);
  font-size: 21rpx;
}

.outfit-create-hit {
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.outfit-create {
  padding: 12rpx 20rpx;
  border: 2rpx solid var(--skin-border);
  border-radius: 999rpx;
  background: var(--skin-surface);
  color: var(--skin-accent);
  font-size: 23rpx;
  font-weight: 900;
}

.outfit-strip {
  width: 100%;
  white-space: nowrap;
}

.outfit-card {
  position: relative;
  display: inline-flex;
  width: 238rpx;
  min-height: 214rpx;
  margin-right: 18rpx;
  padding: 16rpx;
  flex-direction: column;
  vertical-align: top;
  white-space: normal;
  border: 3rpx solid var(--skin-border);
  border-radius: 28rpx;
  background: var(--skin-surface);
  box-shadow: var(--skin-shadow);
}

.outfit-cover {
  display: flex;
  height: 96rpx;
  margin-bottom: 15rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--skin-surface-soft);
}

.outfit-cover-slot {
  position: relative;
  flex: 1;
  min-width: 0;
  border-right: 2rpx solid var(--skin-border);
}

.outfit-cover-slot:last-child { border-right: 0; }
.outfit-cover-slot image { width: 100%; height: 100%; }
.outfit-cover-slot.is-empty { display: flex; align-items: center; justify-content: center; }

.outfit-cover-dot {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid var(--skin-border);
  border-radius: 50%;
  background: var(--skin-surface);
}

.outfit-name {
  max-width: 100%;
  overflow: hidden;
  color: var(--skin-ink);
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-meta {
  margin-top: 7rpx;
  color: var(--skin-muted);
  font-size: 20rpx;
}

.outfit-warning {
  align-self: flex-start;
  margin-top: 9rpx;
  padding: 4rpx 11rpx;
  border-radius: 999rpx;
  background: #fff2c9;
  color: #8d642b;
  font-size: 19rpx;
  font-weight: 900;
}

.outfit-empty,
.outfit-loading,
.outfit-error {
  min-height: 104rpx;
  padding: 28rpx 24rpx;
  border: 2rpx dashed var(--skin-border);
  border-radius: 24rpx;
  background: var(--skin-surface);
  color: var(--skin-muted);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.outfit-error {
  display: flex;
  min-height: var(--touch-target);
  align-items: center;
  justify-content: center;
  color: #9a5f70;
  font-weight: 900;
}

.outfit-stale {
  display: flex;
  min-height: var(--touch-target);
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #fff2c9;
  color: #795522;
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}
