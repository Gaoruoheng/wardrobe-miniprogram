page { height: 100%; }

.outfit-editor {
  position: relative;
  display: flex;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #fff8fc 0%, #f8f0ff 50%, #fff7ec 100%);
}

.editor-top {
  position: relative;
  z-index: 2;
  display: flex;
  padding: calc(env(safe-area-inset-top) + 18rpx) 24rpx 18rpx;
  align-items: center;
  border-bottom: 2rpx solid rgba(207, 169, 232, 0.28);
  background: rgba(255, 250, 252, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(81, 64, 153, 0.07);
}

.editor-heading { min-width: 0; }
.editor-title, .editor-sub { display: block; }
.editor-title { color: #5d4279; font-size: 34rpx; font-weight: 900; }
.editor-sub { margin-top: 5rpx; color: #7d6a70; font-size: 21rpx; }
.editor-scroll { flex: 1; min-height: 0; padding: 24rpx; }

.editor-form-card {
  padding: 26rpx;
  border: 2rpx solid rgba(184, 138, 51, 0.24);
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(255,248,252,.84));
  box-shadow: 0 12rpx 26rpx rgba(81, 64, 153, 0.08);
}

.editor-label { display: block; margin-bottom: 11rpx; color: #5f5157; font-size: 24rpx; font-weight: 900; }
.editor-label.note-label { margin-top: 20rpx; }
.outfit-name-input, .outfit-note-input { width: 100%; border: 2rpx solid rgba(207, 169, 232, 0.42); border-radius: 22rpx; background: rgba(255,255,255,.9); color: #4a3348; font-size: 26rpx; }
.outfit-name-input { height: 82rpx; padding: 0 22rpx; }
.outfit-note-input { min-height: 112rpx; padding: 20rpx 22rpx; }

.editor-selection-head { display: flex; margin-top: 36rpx; align-items: flex-end; justify-content: space-between; }
.editor-section-title, .editor-section-sub { display: block; }
.editor-section-title { color: #5d4279; font-size: 31rpx; font-weight: 900; }
.editor-section-sub { max-width: 440rpx; margin-top: 7rpx; color: #6f6268; font-size: 21rpx; line-height: 1.4; }
.outfit-selected-count { flex-shrink: 0; padding: 9rpx 16rpx; border: 2rpx solid rgba(184, 138, 51, 0.3); border-radius: 999rpx; background: #fff7d9; color: #825c29; font-size: 21rpx; font-weight: 900; }

.outfit-category-strip { width: 100%; margin: 20rpx 0 18rpx; white-space: nowrap; }
.outfit-category { display: inline-flex; min-height: var(--touch-target); margin-right: 12rpx; padding: 0 24rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(207, 169, 232, 0.38); border-radius: 999rpx; background: rgba(255,255,255,.8); color: #765d88; font-size: 23rpx; font-weight: 900; }
.outfit-category.active { border-color: rgba(255,255,255,.88); background: linear-gradient(135deg, #ffd6e7, #a66ed0); color: #fff; box-shadow: 0 7rpx 16rpx rgba(166,110,208,.2); }

.outfit-group { margin-top: 24rpx; }
.outfit-group-title { display: block; margin: 0 0 13rpx 4rpx; color: #5f5157; font-size: 25rpx; font-weight: 900; }
.outfit-item-card { display: flex; min-height: 126rpx; margin-bottom: 14rpx; padding: 14rpx; align-items: center; border: 2rpx solid rgba(207,169,232,.28); border-radius: 26rpx; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 18rpx rgba(81,64,153,.07); }
.outfit-item-card.selected { border-color: #d7a8e8; background: linear-gradient(110deg, #fff, #fff0f7); box-shadow: 0 8rpx 20rpx rgba(166,110,208,.13); }
.outfit-item-image { width: 98rpx; height: 98rpx; margin-right: 16rpx; flex-shrink: 0; border: 2rpx solid rgba(184,138,51,.25); border-radius: 21rpx; background: #fff8e5; }
.outfit-item-main { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.outfit-item-name { overflow: hidden; color: #5f5157; font-size: 27rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.outfit-item-status { align-self: flex-start; margin-top: 9rpx; padding: 4rpx 13rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 900; }
.status-in-use { border: 2rpx solid #d8ccff; background: #f0ecff; color: #6c58b7; }
.status-stored { border: 2rpx solid #c9eed5; background: #eefbf2; color: #3f8758; }
.status-available { border: 2rpx solid #ffd4df; background: #fff0f4; color: #945a6a; }

.outfit-item-check { display: flex; min-width: var(--touch-target); min-height: var(--touch-target); align-items: center; justify-content: flex-end; }
.outfit-check-core { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 3rpx solid #6b5960; border-radius: 50%; background: #fff; color: #6b5960; font-size: 26rpx; font-weight: 900; }
.outfit-check-core.selected { background: linear-gradient(180deg, #ffb7c5, #ffe1ea); color: #fff; }
.editor-loading, .editor-error, .editor-empty { min-height: 130rpx; margin-top: 24rpx; padding: 40rpx 24rpx; border: 2rpx dashed #d7a8e8; border-radius: 26rpx; background: rgba(255,255,255,.68); color: #6f6268; font-size: 24rpx; text-align: center; }
.editor-error { display: flex; min-height: var(--touch-target); align-items: center; justify-content: center; color: #915b6b; font-weight: 900; }
.editor-bottom-spacer { height: calc(190rpx + env(safe-area-inset-bottom)); }

.outfit-save-wrap { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid rgba(207,169,232,.3); background: rgba(255,248,252,.96); box-shadow: 0 -10rpx 24rpx rgba(81,64,153,.09); }
.outfit-save { display: flex; min-height: var(--touch-target); align-items: center; justify-content: center; border: 3rpx solid #6b5960; border-radius: 26rpx; background: linear-gradient(180deg, #ffe680, #ffd84d); box-shadow: 0 5rpx 0 #e8b84a, 0 10rpx 20rpx rgba(107,89,96,.12); color: #5f5157; font-size: 29rpx; font-weight: 900; }
.outfit-save.is-loading { opacity: .66; }
